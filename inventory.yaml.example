datacenter: "<datacenter>"
esxi_hostname: "<esxi_hostname>"
datastore: "<storage>"

network:
  portgroup: "<portgroup>"
  vlan_id: "<vlan_id>"
  vswitch: "<vswitch>"
  subnet: "<subnet>"
  prefix_length: 24
  gateway: "<subnet>.1"

hardware:
  num_cpus: 2
  memory_mb: 4096
  disk_size_gb: 40
  disk_thin: true

timeouts_min:
  clone: 180
  customization: 60
  guest_net: 60
  shutdown: 3

template_name: "wab-template-win2022"

an_vcenter_folder: "vm/wab-benchmark"
an_template_path: "vm/wab-templates"

tf_vcenter_folder: "wab-benchmark"
tf_template_path: "wab-templates"

naming:
  ansible_prefix: "wab-an-"
  terraform_prefix: "wab-tf-"

slots:
  - id: "01"
    spec: "wab-spec-win2022-01"
    ip: "<subnet>.11"
  - id: "02"
    spec: "wab-spec-win2022-02"
    ip: "<subnet>.12"
