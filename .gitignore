# .gitignore fuer ~/iac_lab (WAB "Terraform vs. Ansible")
# Grundsatz: Namensmuster statt exakter Dateinamen; vor jedem git add
# mit "git check-ignore -v <datei>" pruefen.

# --- Zugangsdaten und Schluesselmaterial ---
*.env
*.pem
*.key
*.crt
*.p12
*.pfx
*.ppk
id_rsa*
id_ed25519*

# --- Inventar mit echten Objektreferenzen (versioniert wird nur *.example) ---
[Ii]nventory*.yaml
[Ii]nventory*.yml
[Ii]nventar_roh*.json

# --- Terraform ---
# .terraform.lock.hcl bleibt bewusst versioniert
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
tfplan*
*.tfplan
plan.txt
crash.log
crash.*.log

# --- Python ---
venv*/
.venv/
__pycache__/
*.pyc

# --- Ansible ---
*.retry

# --- Laufzeitdaten des Wrappers (results/*.csv bleibt bewusst versioniert) ---
logs/
run/

# --- Installationsartefakte (gross, teils lizenzpflichtig) ---
# Verzeichnisinhalt ignorieren, requirements.yaml ausnehmen; das geht nur mit "/*",
# nicht mit "wab-setup/", weil Git in ein ignoriertes Verzeichnis nicht hineinsieht.
wab-setup/*
!wab-setup/requirements.yaml
*.iso
*.ISO
*.whl
*.tar.gz
*.zip
