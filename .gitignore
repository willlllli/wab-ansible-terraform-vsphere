# ============================================
# Secrets - unter keinen Umstaenden committen
# ============================================
secrets.env
*.env
!*.env.example

# SSH- und Zertifikatsmaterial
*.pem
*.key
id_rsa*
*.p12
*.pfx
certs/
download.zip

# ============================================
# Terraform
# ============================================
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# tfvars enthaelt Inventar-Bezeichner (vCenter-FQDN, Datastore,
# Portgruppe) - nicht ins Repo. Struktur ueber .example dokumentieren.
*.tfvars
*.tfvars.json
!*.tfvars.example
# .terraform.lock.hcl wird BEWUSST versioniert (Provider-Pinning)

# ============================================
# Ansible
# ============================================
*.retry
ansible.log
# Inventar mit echten Hostnamen / vCenter-Daten
inventar_roh.json
inventory.y*ml
inventory.ini
host_vars/
group_vars/*/vault.yml
!inventory.y*ml.example

# ============================================
# Python / venv
# ============================================
venv-wab/
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ============================================
# Offline-Artefakte (nicht ins Repo, liegen in ~/wab-setup)
# ============================================
wheelhouse/
*.tar.gz
*.zip
*.tf-mirror/

# ============================================
# Editor / OS
# ============================================
.vscode/
.idea/
*.swp
*~
.DS_Store

# ============================================
# Messergebnisse werden BEWUSST versioniert:
# results/*.csv nicht ignorieren - das sind die Forschungsdaten
# ============================================
